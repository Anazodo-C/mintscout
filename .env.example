# ---- LLM (only key required to reproduce the headline numbers) -------------
# The committed LLM cache in data/llm_cache/ means a judge WITHOUT a key can
# still reproduce every number. Set this only to re-run live (--no-cache).
ANTHROPIC_API_KEY=

# ---- RPC (optional) --------------------------------------------------------
# Defaults are the public endpoints; no signup needed.
# ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com
# INK_RPC=https://rpc-gel.inkonchain.com

# ---- Execution safety ------------------------------------------------------
# DRY_RUN=true is the default and is what a judge runs. Live execution needs
# --live AND these caps set explicitly.
DRY_RUN=true
MAX_TOTAL_SPEND_WEI=0
MAX_WALLETS=20

# ---- NEVER COMMIT ----------------------------------------------------------
# BIP-39 mnemonic for the throwaway mint fleet. Env-only; .env is gitignored
# and scripts/scrub_secrets.py blocks mnemonics/hex keys at pre-commit.
MINT_SEED=

# ---- LIVE EXECUTION (Railway) ---------------------------------------------
# BOTH of these must be set to spend. Either one alone keeps it in dry-run.
# LIVE_EXECUTION=false
# DRY_RUN=true

# Hard caps. An unset or unparseable cap is treated as ZERO, not unlimited,
# so the runner refuses to spend rather than guessing.
# MAX_TOTAL_SPEND_WEI=3000000000000000     # 0.003 ETH all-in
# MAX_SPEND_PER_MINT_WEI=500000000000000   # 0.0005 ETH per tx
# MAX_MINTS_TOTAL=5
# MAX_MINTS_PER_HOUR=3                     # unset = unlimited per hour
# MAX_GAS_PRICE_WEI=5000000000             # 5 gwei
# GAS_RESERVE_WEI=800000000000000

# Behaviour
# CHAINS=robinhood
# USE_LLM=true
# ON_LLM_FAILURE=deterministic             # or "skip" to halt on LLM outage
# PREFILTER_MIN_SCORE=45
# MAX_QUANTITY_PER_MINT=2
# POLL_INTERVAL_S=60
# LOOKBACK_MINUTES=20
# MAX_LEAD_SECONDS=7200
# WALLET_INDEX=0
