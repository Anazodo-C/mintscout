# ---- LLM (only key required to reproduce the headline numbers) -------------
# The committed LLM cache in data/llm_cache/ means a judge WITHOUT a key can
# still reproduce every number. Set this only to re-run live (--no-cache).
ANTHROPIC_API_KEY=

# ---- RPC (optional) --------------------------------------------------------
# Defaults are the public endpoints; no signup needed.
# ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com
# INK_RPC=https://rpc-gel.inkonchain.com

# ---- Execution safety ------------------------------------------------------
# DRY_RUN=true is the default and is what a judge runs. Live execution needs
# --live AND these caps set explicitly.
DRY_RUN=true
MAX_TOTAL_SPEND_WEI=0
MAX_WALLETS=20

# ---- NEVER COMMIT ----------------------------------------------------------
# BIP-39 mnemonic for the throwaway mint fleet. Env-only; .env is gitignored
# and scripts/scrub_secrets.py blocks mnemonics/hex keys at pre-commit.
MINT_SEED=
