# ---- LLM (only key required to reproduce the headline numbers) -------------
# The committed LLM cache in data/llm_cache/ means a judge WITHOUT a key can
# still reproduce every number. Set this only to re-run live (--no-cache).
ANTHROPIC_API_KEY=

# ---- RPC (optional) --------------------------------------------------------
# Defaults are the public endpoints; no signup needed.
# ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com
# INK_RPC=https://rpc-gel.inkonchain.com

# ---- Execution safety ------------------------------------------------------
# DRY_RUN=true is the default and is what a judge runs. Live execution needs
# --live AND these caps set explicitly.
DRY_RUN=true
MAX_TOTAL_SPEND_WEI=0
MAX_WALLETS=20

# ---- NEVER COMMIT ----------------------------------------------------------
# BIP-39 mnemonic for the throwaway mint fleet. Env-only; .env is gitignored
# and scripts/scrub_secrets.py blocks mnemonics/hex keys at pre-commit.
MINT_SEED=

# ---- LIVE EXECUTION (Railway) ---------------------------------------------
# BOTH of these must be set to spend. Either one alone keeps it in dry-run.
# LIVE_EXECUTION=false
# DRY_RUN=true

# Hard caps. An unset or unparseable cap is treated as ZERO, not unlimited,
# so the runner refuses to spend rather than guessing.
# MAX_TOTAL_SPEND_WEI=3000000000000000     # 0.003 ETH all-in
# MAX_SPEND_PER_MINT_WEI=500000000000000   # 0.0005 ETH per tx
# MAX_MINTS_TOTAL=5              # REQUIRED to spend. GLOBAL across the whole
#                                # fleet, NOT per wallet: 20 wallets with
#                                # MAX_MINTS_TOTAL=5 gives 5 mints in total.
# MAX_MINTS_PER_HOUR=3                     # unset = unlimited per hour
# MAX_GAS_PRICE_WEI=5000000000             # 5 gwei
# GAS_RESERVE_WEI=800000000000000

# Behaviour
# CHAINS=robinhood
# USE_LLM=true
# ON_LLM_FAILURE=deterministic             # or "skip" to halt on LLM outage
# PREFILTER_MIN_SCORE=45
# MAX_QUANTITY_PER_MINT=2
# POLL_INTERVAL_S=60
# LOOKBACK_MINUTES=20
# MAX_LEAD_SECONDS=7200
# WALLET_INDEX=0                 # first BIP-44 index; fleet is [i, i+MAX_WALLETS)
# MAX_WALLETS=20                 # fleet size derived from MINT_SEED

# ---- SOCIAL GATE ----------------------------------------------------------
# Resolves each candidate's OpenSea profile -> linked X account -> follower/post
# counts, and can auto-approve a mint on that alone. No credentials required.
# SOCIAL_ENABLED=true
# SOCIAL_MIN_FOLLOWERS=1000
# SOCIAL_MIN_POSTS=10
# --- gate B, added after measuring realised secondary volume (2026-09-02) ---
# SOCIAL_VERIFIED_PATH=true      # a VERIFIED X account + a real contract also
#                                # approves, independently of follower reach.
# SOCIAL_MIN_CODE_SIZE=6000      # spam is a ~45-byte ERC-1167 minimal proxy;
#                                # a real implementation is ~19,000+ bytes.
# SOCIAL_AUTO_FLAG=true          # true: passing is SUFFICIENT (auto-MINT)
#                                # false: passing only CONFIRMS; rubric decides
# SOCIAL_MAX_PER_CYCLE=25        # bound lookups per scan
#
# ---- approval policy (operator-set 2026-09-01) ----
# REQUIRE_SOCIAL_APPROVAL=true   # the social signal is the ONLY green flag.
#                                # The rubric still runs and is logged, but a
#                                # high score alone can no longer authorise a mint.
# SKIP_REPEAT_HANDLES=true       # one X account, one mint. A handle reused
#                                # across drops reads as a mill, not a brand.
# STALE_DROP_HOURS=24            # an already-open drop that is not selling is
# STALE_DROP_MIN_FILL=0.5        # failing in public: skip if open >= 24h and
#                                # filled < 50%.
# X_PROVIDER=pulse               # or "twitterapi" (paid fallback)
# TWITTERAPI_IO_KEY=             # only if X_PROVIDER=twitterapi
# OPENSEA_API_KEY=               # OPTIONAL. Without it the public collection
#                                # page is parsed instead; the v2 API 401s.
# REFRESH_SOCIAL=false           # bypass the cache for live operation
